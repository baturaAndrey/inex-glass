{
  "name": "inex-glass",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "payload": "payload",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "migrate:status": "payload migrate:status",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "seed": "payload run src/seed/index.ts --",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:db:reset": "tsx scripts/test-db.ts reset",
    "audit:content": "payload run scripts/audit/content.ts --",
    "audit:seo": "tsx --env-file-if-exists=.env scripts/audit/seo.ts",
    "audit:frequency": "tsx --env-file-if-exists=.env scripts/audit/wordkeeper.ts",
    "analyze": "node -e \"process.env.ANALYZE='true';require('node:child_process').execSync('next build --webpack',{stdio:'inherit'})\"",
    "perf:budget": "tsx scripts/perf/js-budget.ts",
    "perf:lighthouse": "tsx scripts/perf/lighthouse.ts",
    "smoke:prod": "tsx scripts/ops/smoke-prod.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.91.0",
    "@payloadcms/email-nodemailer": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/plugin-search": "3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "@payloadcms/translations": "3.91.0",
    "@payloadcms/ui": "3.91.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-email/components": "1.0.12",
    "busboy": "1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "4.4.0",
    "graphql": "^16.14.2",
    "lucide-react": "^0.539.0",
    "next": "16.4.2",
    "payload": "3.91.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@next/bundle-analyzer": "16.4.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "latest",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/busboy": "1.5.5",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.5",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "^5.0.5",
    "cheerio": "1.2.0",
    "csv-parse": "7.0.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.3",
    "pg": "^8.23.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
