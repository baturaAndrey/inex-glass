# ─── Режим ───────────────────────────────────────────────────────────────
# development | production | test. Обычно не задаётся: Next выставляет сам при dev/build/start
# NODE_ENV=development
# development | staging | production
SITE_ENV=development

# ─── База данных и Payload ───────────────────────────────────────────────
# Локально — Postgres из docker-compose.yml
DATABASE_URL=postgresql://dev_user:dev_password@localhost:5432/inex_glass
# Не короче 32 символов. Сгенерировать: openssl rand -hex 32
PAYLOAD_SECRET=
# true — только для личной одноразовой БД разработчика. НИКОГДА на общей/staging/prod
PAYLOAD_DB_PUSH=false

# ─── Сайт ────────────────────────────────────────────────────────────────
# Публичный адрес сайта (в production обязателен)
SITE_URL=http://localhost:3000
# Не использовать без необходимости: встраивается в бандл при сборке
NEXT_PUBLIC_SITE_URL=
# Только staging: basic auth в формате user:pass
STAGING_BASIC_AUTH=

# ─── Почта ───────────────────────────────────────────────────────────────
# Локально — Mailpit из docker-compose.yml (веб-интерфейс http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Inex Glass <noreply@localhost>"
# Staging: вся исходящая почта уходит на этот адрес
MAIL_INTERCEPT_TO=

# ─── Файлы ───────────────────────────────────────────────────────────────
# Приватные файлы заявок (prod: /data/lead-files)
UPLOADS_DIR=./.data/lead-files
# Медиа (prod: /data/media)
MEDIA_DIR=./.data/media

# ─── Секреты (в production обязательны, не короче 32 символов) ──────────
# Подпись метки времени форм (антиспам)
FORM_HMAC_SECRET=
# Ключ HMAC для ссылок на страницу заказа. Не ротировать без необходимости:
# при смене все выданные ссылки перестанут работать
ORDER_TOKEN_SECRET=

# ─── Фоновые задачи и SEO ────────────────────────────────────────────────
# true — только на одном контейнере
JOBS_ENABLED=false
INDEXNOW_KEY=

# ─── Dev-инструменты (только скрипты разработки; в prod не задавать) ────
KIE_AI_API_KEY=
WORDKEEPER_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
