# Env for test runs (Vitest / Playwright). Test-only values, not real secrets.
# Copy the lines you need into your shell; Playwright reads process.env, not this file.
# Defaults for local runs are built into e2e/helpers/env.ts, so usually nothing is required.

# ─── Same values as the CI job env (.github/workflows/ci.yml) ───────────
DATABASE_URL=postgresql://dev_user:dev_password@localhost:5432/inex_glass_test
PAYLOAD_SECRET=ci-secret-ci-secret-ci-secret-ci-secret
FORM_HMAC_SECRET=ci-hmac-ci-hmac-ci-hmac-ci-hmac-0000
ORDER_TOKEN_SECRET=ci-order-ci-order-ci-order-ci-order-00
SITE_URL=http://localhost:3100
SITE_ENV=development
JOBS_ENABLED=false
# Reuse an existing `.next` build instead of running `pnpm build` before `next start`
# E2E_SKIP_BUILD=1

# ─── Local e2e knobs ─────────────────────────────────────────────────────
# Test DB for e2e locally (wins over DATABASE_URL outside CI). Name must end with _test
E2E_DATABASE_URL=postgresql://dev_user:dev_password@localhost:5432/inex_glass_test
# Maintenance DB for `pnpm test:db:reset`
DATABASE_ADMIN_URL=postgresql://dev_user:dev_password@localhost:5432/postgres
# 1 = allow a test DB on a non-local host (default: only localhost/127.0.0.1/::1/postgres)
# E2E_ALLOW_REMOTE_TEST_DB=1
# Port of the local e2e server (default 3100)
# E2E_PORT=3100
# 1 = skip migrations/seed in global-setup
# E2E_SKIP_DB=1

# ─── E2E admin (e2e/helpers/admin.ts) ───────────────────────────────────
# ONE admin for every spec. Empty users table → registered via first-register; existing user →
# signed in. The suite never resets passwords: if another user owns this e-mail with a different
# password, point these at an existing admin instead. Defaults (also used by CI):
E2E_ADMIN_EMAIL=e2e-admin@inexglass.test
E2E_ADMIN_PASSWORD=e2e-admin-password-0000

# ─── Run against staging (no local server, DB untouched) ────────────────
# E2E_BASE_URL=https://staging.inexglass.ru

# ─── MAX (admin-redesign; e2e/helpers/env.ts → e2eServerEnv) ─────────────
# The e2e server never talks to the real MAX (the bot is shared with a live site): sending is off,
# the token is empty and the API base points at a discard port. Set automatically, listed for info.
# MAX_ENABLED=false
# MAX_BOT_TOKEN=
# MAX_INTERCEPT_CHAT_ID=
# MAX_API_BASE_URL=http://127.0.0.1:9
# Webhook secret / bot nickname used by the webhook and linking specs (test-only values below are
# the defaults; against an external stand provide the stand's own secret):
# E2E_MAX_WEBHOOK_SECRET=e2e-max-webhook-secret-e2e-max-webhook-0000
# E2E_MAX_BOT_NAME=inex_glass_e2e_bot
